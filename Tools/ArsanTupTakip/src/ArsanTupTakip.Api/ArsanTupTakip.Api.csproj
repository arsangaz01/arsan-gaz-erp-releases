<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ArsanTupTakip.Api</RootNamespace>
    <AssemblyName>ArsanTupTakip.Api</AssemblyName>
    <Version>1.3.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebPanel\panel.html" LogicalName="WebPanel.panel.html" />
    <EmbeddedResource Include="WebPanel\panel.js" LogicalName="WebPanel.panel.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArsanTupTakip.Tests" />
  </ItemGroup>

</Project>
