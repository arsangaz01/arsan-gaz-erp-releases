#!/bin/bash
# ArsanTüpTakip yayın betiği (/usr/local/sbin/arsantuptakip-release, root). @TuptakipArsanbot bunu sudo ile çağırır.
# ArsanGazERP'nin arsangaz-release düzeninden tamamen ayrıdır: kendi deposu, GitHub anahtarı, derleme kullanıcısı ve durum
# klasörü vardır; ERP servislerine, arsangaz-release'e ve /etc/arsangaz'a dokunmaz.
#   status          API sağlığı, veritabanı, tablo kayıt sayıları, son yedek, yayındaki commit (salt okunur)
#   sync            GitHub'daki main'i ajanın okuduğu yerel aynaya alır
#   pending         ajanın commit paketini içeri alır; yayınlanacak hedefi, değişen dosyaları ve kapsam kontrolünü yazar
#   publish <sha>   hedefi sunucuda derler + test eder; ajan dalıysa main'e birleştirip GitHub'a gönderir; /opt/arsantuptakip'e
#                   kurar, sağlık kontrolü geçmezse önceki kuruluma otomatik döner
#   previous        geri alınabilecek önceki kurulumu yazar
#   rollback        önceki kuruluma döner (şimdiki kurulum "önceki" olur)
#   apkcheck        main'deki mobil uygulama sürümü, yayındaki APK ve GitHub Actions'taki imzalı APK durumu
#   apk <sha>       o commit'in mobil kodundan derlenmiş imzalı APK'yı (arsantuptakip.yml, main) indirir; imza sertifikası,
#                   paket adı ve sürümü doğrulanınca /var/lib/arsantuptakip'e koyar (/tuptakip/indir, /tuptakip/api/guncelleme)
#   apkinfo <dosya> APK'nın paket adı, versionName ve versionCode'unu yazar (sekmeyle ayrılmış; CI bunu aapt ile karşılaştırır)
# Çıktının "@@ANAHTAR=değer" satırları bot içindir.
set -euo pipefail
umask 022

ACTION=${1:-}
ARG=${2:-}
STAMP=$(date +%Y%m%d-%H%M%S)

REPO_URL=git@github.com:arsangaz01/arsan-gaz-erp-kaynak.git
AGENT_BRANCH=cursor/arsantuptakip-agent
SCOPE=Tools/ArsanTupTakip
BASE=/var/lib/arsantuptakip-release
BUNDLE=/var/lib/arsantuptakip-queue/outgoing/agent-branch.bundle
KEYDIR=/etc/arsantuptakip/release
APP_PARENT=/opt/arsantuptakip
UNIT=arsantuptakip-api
PORT=5080
SDK=/opt/dotnet-sdk
BUILD_USER=tuptakipbuild
QUEUE_GROUP=tuptakipq
BACKUP_STATUS=/var/lib/arsantuptakip-backup/status.json
BACKUP_DIR=/var/backups/arsantuptakip
DB=arsantuptakip
GH_REPO=arsangaz01/arsan-gaz-erp-kaynak
CI_WORKFLOW=arsantuptakip.yml
APK_ARTIFACT=arsantuptakip-mobile-apk
APK_PACKAGE=com.arsantuptakip.mobil
# SHA-256 of the signing certificate (the same key as the ArsanGaz app; ci.yml and arsantuptakip.yml check it too).
APK_CERT_SHA256=80ae16deb437fd9e1c7b26b3b38563977078c97a98a17f6983b7d5f19dd90153
MOBILE_CSPROJ=$SCOPE/mobile/ArsanTupTakip.Mobile/ArsanTupTakip.Mobile.csproj
MOBILE_PATHS=("$SCOPE/mobile" "$SCOPE/Directory.Build.props" "$SCOPE/global.json")
DATA_DIR=/var/lib/arsantuptakip
API_USER=arsantuptakip
APK_NAME=ArsanTupTakip-Mobil.apk
GITHUB_ENV_FILE=/etc/arsantuptakip/github.env
PUBLIC_URL=https://arsantuptakip.com/tuptakip
GH_TOKEN=""
SANDBOX=""
# test-release.sh: ARSANTUPTAKIP_RELEASE_SANDBOX=1 with its own paths; no root, no systemd, no GitHub, fake build.
# SANDBOX_APK_ZIP stands in for the GitHub artifact; the certificate then comes from its apk-info.json.
if [ "${ARSANTUPTAKIP_RELEASE_SANDBOX:-}" = 1 ]; then
  SANDBOX=1
  REPO_URL=$SANDBOX_ORIGIN
  BASE=$SANDBOX_BASE
  BUNDLE=$SANDBOX_BUNDLE
  APP_PARENT=$SANDBOX_APP_PARENT
  DATA_DIR=${SANDBOX_DATA_DIR:-$SANDBOX_BASE/data}
fi
REPO=$BASE/repo
MIRROR=$BASE/mirror.git
BUILD=$BASE/build
STATE=$BASE/state
LOGDIR=$BASE/logs
APP_DIR=$APP_PARENT/api
PREV_DIR=$APP_PARENT/api.prev

say() { printf '%s\n' "$*"; }
trailer() { printf '@@%s=%s\n' "$1" "$2"; }
die() { say "❌ $1"; exit "${2:-1}"; }
short() { printf '%s' "${1:0:7}"; }
sha_or() { if [ -n "$1" ] && [ "$1" != - ]; then short "$1"; else printf '%s' "$2"; fi; }
git_r() { git -C "$REPO" -c core.hooksPath=/dev/null -c advice.detachedHead=false "$@"; }
git_net() { timeout 180 git -C "$REPO" -c core.hooksPath=/dev/null "$@"; }
rev() { git_r rev-parse -q --verify "$1^{commit}" 2>/dev/null || true; }
deployed_sha() { cat "$1/.release-sha" 2>/dev/null || true; }

if [ -z "$SANDBOX" ]; then
  [ "$(id -u)" = 0 ] || die "root olarak çalışmalı (sudo)." 2
  export GIT_SSH_COMMAND="ssh -i $KEYDIR/github_release -o IdentitiesOnly=yes -o UserKnownHostsFile=$KEYDIR/known_hosts -o StrictHostKeyChecking=yes -o BatchMode=yes"
fi

# Mutating actions run as a transient systemd unit: they leave the bot's cgroup and sandbox, so a bot restart cannot
# interrupt a release and /opt is writable.
case "$ACTION" in
  sync|pending|publish|rollback|apkcheck|apk)
    if [ -z "$SANDBOX" ] && [ -z "${ARSANTUPTAKIP_RELEASE_DETACHED:-}" ]; then
      exec systemd-run --quiet --wait --pipe --collect --unit "arsantuptakip-release-$STAMP-$$" \
        -p Description="ArsanTupTakip yayin ($ACTION)" -E ARSANTUPTAKIP_RELEASE_DETACHED=1 -E LANG=C.UTF-8 \
        /usr/local/sbin/arsantuptakip-release "$ACTION" ${ARG:+"$ARG"}
    fi ;;
esac

lock() {
  install -d -m 0711 "$BASE"
  exec 9>"$BASE/lock"
  flock -w 5 9 || die "Başka bir yayın işlemi sürüyor; biraz sonra tekrar deneyin." 9
}

svc() {
  if [ -n "$SANDBOX" ]; then printf '%s %s\n' "$1" "$UNIT" >> "$BASE/systemctl.log"; return 0; fi
  systemctl "$1" "$UNIT"
}

# ---------------------------------------------------------------- git
ensure_repo() {
  install -d -m 0711 "$BASE"
  install -d -m 0700 "$STATE" "$LOGDIR"
  if [ ! -d "$REPO/.git" ]; then
    install -d -m 0700 "$REPO"
    git init -q -b main "$REPO"
    git_r remote add origin "$REPO_URL"
    git_r config user.name "ArsanTupTakip Yayin (sunucu)"
    git_r config user.email "release@arsantuptakip.local"
  fi
  if [ ! -f "$MIRROR/HEAD" ]; then
    git init -q --bare -b main "$MIRROR"
  fi
}

fetch() {
  ensure_repo
  local out
  if [ -z "$SANDBOX" ] && [ ! -f "$KEYDIR/github_release" ]; then die "Yayın anahtarı yok; install-bot.sh çalıştırılmamış." 4; fi
  if ! out=$(git_net fetch -q --prune origin '+refs/heads/main:refs/remotes/origin/main' 2>&1); then
    if grep -qiE 'denied|publickey|not found|could not read' <<<"$out"; then
      die "GitHub'a bağlanılamadı: ArsanTüpTakip yayın anahtarı GitHub'a deploy key (yazma izinli) olarak eklenmemiş olabilir." 4
    fi
    die "GitHub'dan güncelleme alınamadı: $(tail -n1 <<<"$out")" 4
  fi
}

# The agent's clone reads only this mirror (no GitHub key on the agent side).
update_mirror() {
  git_r push -q --force "$MIRROR" "refs/remotes/origin/main:refs/heads/main" >/dev/null 2>&1 || die "Yerel ayna güncellenemedi." 5
  if [ -z "$SANDBOX" ]; then
    chown -R root:"$QUEUE_GROUP" "$MIRROR"
    chmod -R u=rwX,g=rX,o= "$MIRROR"
  fi
}

# Imports the agent's commits (git bundle written by dev-agent.js) as refs/remotes/agent/branch.
import_bundle() {
  git_r update-ref -d refs/remotes/agent/branch 2>/dev/null || true
  [ -f "$BUNDLE" ] || return 0
  local size; size=$(stat -c %s "$BUNDLE")
  if [ "$size" -gt $((200 * 1024 * 1024)) ]; then say "⚠️ Ajan paketi çok büyük ($size bayt); içeri alınmadı."; return 0; fi
  if ! git_r bundle verify -q "$BUNDLE" >/dev/null 2>&1; then
    say "⚠️ Ajan paketi doğrulanamadı (main çok ilerlemiş olabilir); ajana yeni bir istek gönderildiğinde yenilenir."
    return 0
  fi
  git_r fetch -q "$BUNDLE" "+refs/heads/$AGENT_BRANCH:refs/remotes/agent/branch" 2>/dev/null \
    || say "⚠️ Ajan paketi içeri alınamadı."
}

# Paths changed by the agent branch since it left main that are outside Tools/ArsanTupTakip/.
out_of_scope() {
  local main=$1 br=$2 mb
  mb=$(git_r merge-base "$main" "$br")
  git_r diff --name-only "$mb" "$br" | grep -v "^$SCOPE/" || true
}

app_changed() { ! git_r diff --quiet "$1" "$2" -- "$SCOPE/src" "$SCOPE/global.json" "$SCOPE/Directory.Build.props" 2>/dev/null; }

# ---------------------------------------------------------------- build + deploy
build_and_test() {
  local sha=$1 out=$2 log
  log="$LOGDIR/build-$STAMP.log"
  rm -rf "$BUILD"
  install -d -m 0750 "$BUILD" "$BUILD/src" "$BUILD/out"
  git_r archive "$sha" "$SCOPE" | tar -x -C "$BUILD/src"
  if [ -n "$SANDBOX" ]; then
    [ ! -e "$BUILD/src/$SCOPE/SANDBOX_BUILD_FAIL" ] || { say "Derleme hatası (benzetim)."; return 1; }
    cp -a "$BUILD/src/$SCOPE/." "$BUILD/out/"
  else
    id "$BUILD_USER" >/dev/null 2>&1 || die "$BUILD_USER kullanıcısı yok; install-bot.sh çalıştırılmamış." 5
    [ -x "$SDK/dotnet" ] || die ".NET SDK ($SDK) yok." 5
    # Persistent home: the NuGet cache survives between releases.
    install -d -m 0750 -o "$BUILD_USER" -g "$BUILD_USER" "$BASE/buildhome"
    chown -R "$BUILD_USER:$BUILD_USER" "$BUILD"
    local dir="$BUILD/src/$SCOPE"
    local run=(timeout 1500 runuser -u "$BUILD_USER" -- env -i HOME="$BASE/buildhome" PATH="$SDK:/usr/bin:/bin" DOTNET_ROOT="$SDK"
      DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_CLI_USE_MSBUILD_SERVER=0
      NUGET_PACKAGES="$BASE/buildhome/.nuget/packages")
    say "🔨 Derleniyor ($(short "$sha"))..."
    if ! "${run[@]}" "$SDK/dotnet" build "$dir/ArsanTupTakip.slnx" -c Release -nologo -clp:ErrorsOnly \
        -p:UseSharedCompilation=false -nodeReuse:false > "$log" 2>&1 9>&-; then
      say "Derleme hatası (son satırlar):"; grep -E 'error' "$log" | tail -n 8 | sed -E "s#$BUILD/src/##"
      return 1
    fi
    say "🧪 Testler çalışıyor..."
    if ! "${run[@]}" "$SDK/dotnet" run --project "$dir/tests/ArsanTupTakip.Tests/ArsanTupTakip.Tests.csproj" -c Release --no-build \
        >> "$log" 2>&1 9>&-; then
      say "Test hatası (son satırlar):"; tail -n 12 "$log" | sed -E "s#$BUILD/src/##"
      return 1
    fi
    if [ -x /usr/bin/node ] && ! /usr/bin/node --check "$dir/src/ArsanTupTakip.Api/WebPanel/panel.js" >> "$log" 2>&1; then
      say "panel.js sözdizimi hatalı."; return 1
    fi
    if ! "${run[@]}" "$SDK/dotnet" publish "$dir/src/ArsanTupTakip.Api/ArsanTupTakip.Api.csproj" -c Release --no-build \
        -o "$BUILD/out" -nologo -clp:ErrorsOnly -p:UseSharedCompilation=false -nodeReuse:false >> "$log" 2>&1 9>&-; then
      say "Yayın paketi hazırlanamadı:"; tail -n 8 "$log" | sed -E "s#$BUILD/src/##"
      return 1
    fi
    [ -f "$BUILD/out/ArsanTupTakip.Api.dll" ] || { say "Derleme çıktısı eksik."; return 1; }
    say "✅ Derleme ve testler başarılı."
  fi
  rm -rf "$out"; mkdir -p "$out"
  cp -a "$BUILD/out/." "$out/"
  printf '%s\n' "$sha" > "$out/.release-sha"
  [ -n "$SANDBOX" ] || { chown -R root:root "$out"; chmod -R u=rwX,go=rX "$out"; }
}

health() {
  local since=$1 i
  if [ -n "$SANDBOX" ]; then [ ! -e "$APP_DIR/SANDBOX_HEALTH_FAIL" ]; return; fi
  for i in $(seq 1 30); do
    sleep 2
    systemctl is-active --quiet "$UNIT" || continue
    curl -fsS --max-time 5 "http://127.0.0.1:$PORT/tuptakip/api/merhaba" 2>/dev/null | grep -q '"ArsanTupTakip.Api"' || continue
    [ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://127.0.0.1:$PORT/tuptakip/panel")" = 200 ] || continue
    if journalctl -u "$UNIT" --since "$since" --no-pager -o cat 2>/dev/null | grep -qE 'Unhandled exception|şeması hazırlanamadı'; then
      say "   Başlangıç günlüğünde hata var:"; journalctl -u "$UNIT" --since "$since" --no-pager -o cat | grep -E 'Unhandled|hazırlanamadı' | tail -n 3 | sed 's/^/   /'
      return 1
    fi
    return 0
  done
  say "   60 sn içinde sağlıklı yanıt gelmedi."
  return 1
}

# ---------------------------------------------------------------- mobile APK
# Python reads API responses from stdin (never argv: large JSON exceeds the argument size limit).
py_json() { local data=$1; shift; printf '%s' "$data" | python3 -c "$@"; }

load_token() {
  [ -z "$SANDBOX" ] || return 0
  GH_TOKEN=$(grep -E '^GITHUB_ACTIONS_TOKEN=' "$GITHUB_ENV_FILE" 2>/dev/null | tail -n1 | cut -d= -f2- | tr -d "\"' \r" || true)
  [ -n "$GH_TOKEN" ] || die "GitHub okuma anahtarı yok ($GITHUB_ENV_FILE); install-bot.sh çalıştırılmamış." 4
}

# The token goes through a curl config on a pipe, so it never appears in a process list.
gh_curl() {
  curl -fsSL -K <(printf 'header = "Authorization: Bearer %s"\n' "$GH_TOKEN") "$@"
}

gh_api() {
  gh_curl --max-time 30 -H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28" "https://api.github.com/repos/$GH_REPO$1"
}

# "<versionCode> <versionName>" of the mobile app at a commit (csproj); "0 -" when unreadable.
mobile_expected() {
  local xml code name
  xml=$(git_r show "$1:$MOBILE_CSPROJ" 2>/dev/null) || { echo "0 -"; return 0; }
  code=$(grep -oP '(?<=<ApplicationVersion>)[0-9]+' <<<"$xml" | head -n1 || true)
  name=$(grep -oP '(?<=<ApplicationDisplayVersion>)[^<]+' <<<"$xml" | head -n1 || true)
  echo "${code:-0} ${name:--}"
}

# "<versionCode> <versionName> <sha>" of the APK phones are offered now; "0 - -" when there is none.
apk_published() {
  [ -f "$DATA_DIR/$APK_NAME" ] || { echo "0 - -"; return 0; }
  python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(int(d["versionCode"]), d.get("versionName") or "-", d.get("sha") or "-")' \
    "$DATA_DIR/$APK_NAME.meta.json" 2>/dev/null || echo "0 - -"
}

# package<TAB>versionName<TAB>versionCode from the binary AndroidManifest.xml (no aapt on the server).
apk_manifest() {
  python3 - "$1" <<'PY'
import struct, sys, zipfile
data = zipfile.ZipFile(sys.argv[1]).read("AndroidManifest.xml")
if struct.unpack_from("<H", data, 0)[0] != 0x0003:
    sys.exit("AndroidManifest.xml ikili XML değil")
ids = {0x0101021B: "versionCode", 0x0101021C: "versionName"}
strings, resmap, pos = [], [], struct.unpack_from("<H", data, 2)[0]
while pos + 8 <= len(data):
    kind, head, size = struct.unpack_from("<HHI", data, pos)
    if size < 8:
        break
    if kind == 0x0001:  # string pool
        count, _styles, flags, start = struct.unpack_from("<IIII", data, pos + 8)
        for i in range(count):
            off = pos + start + struct.unpack_from("<I", data, pos + head + 4 * i)[0]
            if flags & 0x100:  # UTF-8: utf16 length, utf8 length, bytes
                off += 2 if data[off] & 0x80 else 1
                n = data[off]
                if n & 0x80:
                    n, off = ((n & 0x7F) << 8) | data[off + 1], off + 2
                else:
                    off += 1
                strings.append(data[off:off + n].decode("utf-8", "replace"))
            else:
                n = struct.unpack_from("<H", data, off)[0]
                off += 2
                if n & 0x8000:
                    n, off = ((n & 0x7FFF) << 16) | struct.unpack_from("<H", data, off)[0], off + 2
                strings.append(data[off:off + 2 * n].decode("utf-16-le", "replace"))
    elif kind == 0x0180:  # resource ids of the attribute names
        resmap = list(struct.unpack_from("<%dI" % ((size - head) // 4), data, pos + head))
    elif kind == 0x0102:  # start element
        if strings[struct.unpack_from("<I", data, pos + head + 4)[0]] == "manifest":
            astart, asize, acount = struct.unpack_from("<HHH", data, pos + head + 8)
            found = {}
            for i in range(acount):
                _ns, name, raw, _len, _res, dtype, value = struct.unpack_from("<IIIHBBI", data, pos + head + astart + i * asize)
                key = ids.get(resmap[name] if name < len(resmap) else 0, strings[name])
                if raw != 0xFFFFFFFF:
                    found[key] = strings[raw]
                elif dtype == 0x03:
                    found[key] = strings[value]
                else:
                    found[key] = str(value)
            print(found.get("package", ""), found.get("versionName", ""), found.get("versionCode", ""), sep="\t")
            sys.exit(0)
    pos += size
sys.exit("manifest öğesi bulunamadı")
PY
}

# Newest successful arsantuptakip.yml main run whose mobile sources equal $1's and that has the APK artifact.
# Sets APK_URL / APK_RUN, and APK_WAITING=1 when a matching run is still going. Returns 1 when GitHub is unreachable.
find_apk_run() {
  local sha=$1 runs list id head status conclusion arts url
  APK_URL=""; APK_RUN=""; APK_WAITING=0
  if [ -n "$SANDBOX" ]; then
    if [ -n "${SANDBOX_APK_ZIP:-}" ]; then APK_URL="file://$SANDBOX_APK_ZIP"; APK_RUN=sandbox; fi
    return 0
  fi
  runs=$(gh_api "/actions/workflows/$CI_WORKFLOW/runs?branch=main&per_page=30" 2>/dev/null) || return 1
  list=$(py_json "$runs" '
import json, sys
for r in json.load(sys.stdin).get("workflow_runs", []):
    print(r["id"], r["head_sha"], r["status"], r.get("conclusion") or "-")
') || return 1
  while read -r id head status conclusion; do
    [ -n "$id" ] || continue
    git_r cat-file -e "$head^{commit}" 2>/dev/null || continue
    git_r diff --quiet "$head" "$sha" -- "${MOBILE_PATHS[@]}" 2>/dev/null || continue
    if [ "$status" != completed ]; then APK_WAITING=1; continue; fi
    [ "$conclusion" = success ] || continue
    arts=$(gh_api "/actions/runs/$id/artifacts" 2>/dev/null) || continue
    url=$(py_json "$arts" 'import json,sys; a=[x for x in json.load(sys.stdin).get("artifacts",[]) if x["name"]==sys.argv[1] and not x["expired"]]; print(a[0]["archive_download_url"] if a else "")' "$APK_ARTIFACT")
    if [ -n "$url" ]; then APK_URL=$url; APK_RUN=$id; return 0; fi
  done <<<"$list"
  return 0
}

# Puts $1 in place (current -> api.prev), restarts and health-checks; on failure the previous build comes back.
# Returns 0 ok, 2 rolled back, 3 rollback failed too.
swap_in() {
  local new=$1 incoming since
  incoming="$APP_PARENT/.incoming-$STAMP"
  rm -rf "$incoming"; cp -a "$new" "$incoming"
  since=$(date '+%Y-%m-%d %H:%M:%S')
  local had_prev=0
  if [ -d "$APP_DIR" ]; then rm -rf "$PREV_DIR"; mv "$APP_DIR" "$PREV_DIR"; had_prev=1; fi
  mv "$incoming" "$APP_DIR"
  svc restart
  if health "$since"; then return 0; fi
  say "↩️ Yeni kurulum sağlık kontrolünden geçemedi; önceki kuruluma dönülüyor."
  svc stop || true
  rm -rf "$APP_PARENT/api.failed-"*; mv "$APP_DIR" "$APP_PARENT/api.failed-$STAMP"
  if [ $had_prev = 0 ]; then say "   Önceki kurulum yok; geri dönülemedi."; return 3; fi
  mv "$PREV_DIR" "$APP_DIR"
  since=$(date '+%Y-%m-%d %H:%M:%S')
  svc start
  if health "$since"; then say "   Önceki kurulum ($(short "$(deployed_sha "$APP_DIR")")) yeniden çalışıyor."; return 2; fi
  say "   ⚠️ Önceki kurulum da sağlıklı açılmadı!"
  return 3
}

# ---------------------------------------------------------------- actions
act_status() {
  local active merhaba deployed prev
  if [ -n "$SANDBOX" ]; then active=sandbox; merhaba='{}'; else
    active=$(systemctl is-active "$UNIT" 2>/dev/null || true)
    merhaba=$(curl -s --max-time 5 "http://127.0.0.1:$PORT/tuptakip/api/merhaba" 2>/dev/null || true)
  fi
  if [ "$active" = active ] && grep -q '"ArsanTupTakip.Api"' <<<"$merhaba"; then
    say "🟢 API: çalışıyor (127.0.0.1:$PORT/tuptakip, sürüm $(sed -nE 's/.*"version":"([^"]*)".*/\1/p' <<<"$merhaba"))"
  else
    say "🔴 API: sağlıksız (servis: ${active:-?}, /api/merhaba yanıt vermedi)"
  fi
  deployed=$(deployed_sha "$APP_DIR"); prev=$(deployed_sha "$PREV_DIR")
  say "📦 Yayındaki commit: $(sha_or "$deployed" "bilinmiyor (elle kurulum)")$( [ -d "$PREV_DIR" ] && printf ' · önceki kurulum: %s' "$(sha_or "$prev" "elle kurulum")")"
  local acode aname asha
  read -r acode aname asha <<<"$(apk_published)"
  if [ "$acode" -gt 0 ]; then say "📱 APK: $aname (build $acode, commit $(sha_or "$asha" bilinmiyor)) · $PUBLIC_URL/indir"; else say "📱 APK: yayında değil"; fi
  if [ -d "$REPO/.git" ]; then
    local main br ahead=0
    main=$(rev refs/remotes/origin/main); br=$(rev refs/remotes/agent/branch)
    if [ -n "$br" ] && [ -n "$main" ] && ! git_r merge-base --is-ancestor "$br" "$main"; then ahead=$(git_r rev-list --count "$main..$br"); fi
    say "🌿 main (son bakılan): $(sha_or "$main" bilinmiyor); ajanın yayın bekleyen commit'i: $ahead"
  fi
  if [ -z "$SANDBOX" ]; then
    if runuser -u postgres -- psql -X -At -d "$DB" -c 'SELECT 1' >/dev/null 2>&1; then
      local tables t count lines=()
      tables=$(runuser -u postgres -- psql -X -At -d "$DB" -c "SELECT table_name FROM information_schema.tables WHERE table_schema='tuptakip' AND table_type='BASE TABLE' ORDER BY 1" 2>/dev/null || true)
      for t in $tables; do
        [[ "$t" =~ ^[A-Za-z0-9_]+$ ]] || continue
        count=$(runuser -u postgres -- psql -X -At -d "$DB" -c "SELECT count(*) FROM tuptakip.\"$t\"" 2>/dev/null || echo "?")
        lines+=("$t $count")
      done
      say "🗄 Veritabanı: erişilebilir ($DB, ${#lines[@]} tablo)"
      for t in "${lines[@]}"; do say "   • $t"; done
    else
      say "🔴 Veritabanı: erişilemiyor ($DB)"
    fi
    if [ -f "$BACKUP_STATUS" ]; then
      python3 - "$BACKUP_STATUS" <<'PY' || say "💾 Son yedek: durum dosyası okunamadı"
import json, sys, datetime
s = json.load(open(sys.argv[1], encoding="utf-8"))
utc = datetime.datetime.fromisoformat(s["utc"].replace("Z", "+00:00"))
local = utc.astimezone(datetime.timezone(datetime.timedelta(hours=3)))
icon = "💾" if s.get("ok") else "⚠️"
print(f"{icon} Son yedek: {local:%d.%m.%Y %H:%M} ({'başarılı' if s.get('ok') else 'HATALI'}) — {s.get('message', '')}")
PY
    else
      say "💾 Son yedek: henüz yok"
    fi
    local newest; newest=$(ls -t "$BACKUP_DIR"/arsantuptakip-*.dump 2>/dev/null | head -n1 || true)
    [ -n "$newest" ] && say "   Sunucudaki en yeni döküm: $(basename "$newest")"
  fi
  return 0
}

act_sync() {
  lock; fetch; update_mirror
  say "🔄 Ayna güncel: main $(short "$(rev refs/remotes/origin/main)")"
}

act_pending() {
  lock; fetch; update_mirror; import_bundle
  local main br target deployed outside
  main=$(rev refs/remotes/origin/main); br=$(rev refs/remotes/agent/branch)
  [ -n "$main" ] || die "origin/main okunamadı."
  deployed=$(deployed_sha "$APP_DIR")
  if [ -n "$br" ] && ! git_r merge-base --is-ancestor "$br" "$main"; then
    target=$br
    local ahead; ahead=$(git_r rev-list --count "$main..$br")
    say "📦 Ajanın yayın bekleyen $ahead commit'i var (main: $(short "$main")):"
    git_r log --no-merges --format='• %h %s' -n 15 "$main..$br"
    [ "$ahead" -gt 15 ] && say "• ..."
    say ""; say "Değişen dosyalar:"
    git_r diff --stat=80 "$(git_r merge-base "$main" "$br")" "$br" | tail -n 12 | sed 's/^/ /'
    outside=$(out_of_scope "$main" "$br")
    if [ -n "$outside" ]; then
      say ""; say "⛔ Ajan dalı Tools/ArsanTupTakip dışındaki dosyalara dokunuyor; yayınlanamaz:"
      head -n 10 <<<"$outside" | sed 's/^/   /'
      trailer BLOCKED 1
    fi
    if git_r merge-base --is-ancestor "$main" "$br"; then
      say "Birleştirme: hızlı ileri (main doğrudan bu commit'e alınır)."
    elif git_r merge-tree --write-tree "$main" "$br" >/dev/null 2>&1; then
      say "Birleştirme: main ilerlemiş; çakışmasız birleştirme commit'i oluşturulacak."
    else
      say "⚠️ main ile ÇAKIŞMA var; yayın yapılamaz. Ajandan dalı main ile uyumlu hale getirmesini isteyin."
      trailer CONFLICT 1
    fi
  else
    target=$main
    say "📦 Ajanın yayın bekleyen commit'i yok. main: $(short "$main") $(git_r log -1 --format=%s "$main")"
    if [ -n "$deployed" ] && [ -n "$(rev "$deployed")" ] && ! app_changed "$deployed" "$main"; then
      say "🌐 Yayındaki kurulum ($(short "$deployed")) main ile güncel; yayınlanacak yeni değişiklik yok."
      trailer NOTHING 1
    fi
  fi
  if [ -z "$deployed" ]; then
    say "Sunucudaki kurulum: commit'i bilinmiyor (elle kurulum); yayında yeniden derlenip kurulur."
  else
    say "Sunucudaki kurulum: $(short "$deployed")."
  fi
  say "Yayın: sunucuda derleme + testler → (ajan dalıysa) main'e birleştirme ve GitHub'a gönderme → kurulum → sağlık kontrolü (başarısızsa otomatik geri dönüş)."
  trailer TARGET "$target"
}

act_publish() {
  local want=$1 main br target newmain rc=0 outside
  [[ "$want" =~ ^[0-9a-f]{40}$ ]] || die "Geçersiz commit kimliği." 2
  lock; fetch; import_bundle
  main=$(rev refs/remotes/origin/main); br=$(rev refs/remotes/agent/branch)
  if [ -n "$br" ] && [ "$br" = "$want" ] && ! git_r merge-base --is-ancestor "$br" "$main"; then target=agent
  elif [ "$main" = "$want" ]; then target=main
  else die "Onaylanan commit ($(short "$want")) artık yayın hedefi değil; dal veya main değişmiş olabilir. /yayin ile yeniden bakın." 6
  fi

  newmain=$main
  if [ "$target" = agent ]; then
    outside=$(out_of_scope "$main" "$br")
    [ -z "$outside" ] || die "Ajan dalı Tools/ArsanTupTakip dışındaki dosyalara dokunuyor ($(head -n 3 <<<"$outside" | tr '\n' ' ')); yayın durduruldu." 3
    if git_r merge-base --is-ancestor "$main" "$br"; then
      newmain=$br
    else
      git_r checkout -q --detach "$main"
      if ! git_r merge -q --no-ff -m "ArsanTupTakip yayin: $AGENT_BRANCH main ile birlestirildi (Telegram onayi)" "$br" >/dev/null 2>&1; then
        git_r merge --abort || true
        die "Birleştirme çakıştı; hiçbir şey gönderilmedi." 3
      fi
      newmain=$(git_r rev-parse HEAD)
    fi
  fi

  # The exact tree that becomes main is what gets built, tested and deployed.
  build_and_test "$newmain" "$BUILD/release" || die "Derleme/test başarısız; main'e birleştirilmedi ve kurulmadı. Önceki kurulum çalışmaya devam ediyor." 1

  if [ "$target" = agent ]; then
    local out
    out=$(git_net push -q --atomic origin "$newmain:refs/heads/main" "+$br:refs/heads/$AGENT_BRANCH" 2>&1) \
      || die "main GitHub'a gönderilemedi (yayın anahtarının yazma izni var mı?): $(tail -n1 <<<"$out")" 4
    git_r update-ref refs/remotes/origin/main "$newmain"
    say "⬆️ main GitHub'a gönderildi: $(short "$main") → $(short "$newmain")"
    update_mirror
    rm -f "$BUNDLE"
  fi

  swap_in "$BUILD/release" || rc=$?
  case $rc in
    0) say "🌐 ArsanTüpTakip API yayında: $(short "$newmain") (önceki kurulum yedekte; /geri_al ile dönülebilir)." ;;
    2) say "⚠️ Yeni sürüm sağlık kontrolünden geçemedi; otomatik olarak önceki kuruluma dönüldü."
       [ "$target" = agent ] && say "   Not: değişiklik main'de; düzeltme için ajana yeni istek gönderin." ;;
    *) say "🚨 API sağlıklı değil ve geri dönüş başarısız! Sunucuya bakılmalı." ;;
  esac
  printf '%s %s %s\n' "$STAMP" "$newmain" "$rc" >> "$STATE/history"
  trailer MAIN "$newmain"
  return $rc
}

act_previous() {
  local current prev
  current=$(deployed_sha "$APP_DIR"); prev=$(deployed_sha "$PREV_DIR")
  [ -d "$PREV_DIR" ] || die "Önceki kurulum yok." 6
  say "Şu anki kurulum: $(sha_or "$current" "elle kurulum")"
  say "Dönülecek önceki kurulum: $(sha_or "$prev" "elle kurulum (commit bilinmiyor)")"
  trailer PREVIOUS "${prev:-manual}"
}

act_rollback() {
  lock
  [ -d "$PREV_DIR" ] || die "Önceki kurulum yok." 6
  local since tmp="$APP_PARENT/.rollback-$STAMP"
  since=$(date '+%Y-%m-%d %H:%M:%S')
  mv "$APP_DIR" "$tmp"; mv "$PREV_DIR" "$APP_DIR"; mv "$tmp" "$PREV_DIR"
  svc restart
  if health "$since"; then
    say "↩️ Önceki kuruluma dönüldü: $(short "$(deployed_sha "$APP_DIR")") çalışıyor (geri alınan kurulum yedekte)."
    printf '%s rollback %s 0\n' "$STAMP" "$(deployed_sha "$APP_DIR")" >> "$STATE/history" 2>/dev/null || true
    return 0
  fi
  say "⚠️ Önceki kurulum sağlıklı açılmadı; yeniden şimdiki kuruluma dönülüyor."
  mv "$APP_DIR" "$tmp"; mv "$PREV_DIR" "$APP_DIR"; mv "$tmp" "$PREV_DIR"
  since=$(date '+%Y-%m-%d %H:%M:%S')
  svc restart
  health "$since" && { say "   Şimdiki kurulum yeniden çalışıyor."; return 2; }
  say "🚨 API sağlıklı değil! Sunucuya bakılmalı."
  return 3
}

act_apkcheck() {
  lock; fetch; load_token
  local main ecode ename ccode cname csha
  main=$(rev refs/remotes/origin/main)
  [ -n "$main" ] || die "origin/main okunamadı."
  read -r ecode ename <<<"$(mobile_expected "$main")"
  read -r ccode cname csha <<<"$(apk_published)"
  say "📱 main ($(short "$main")): ArsanTüpTakip mobil $ename (build $ecode)"
  if [ "$ccode" -gt 0 ]; then say "   Yayındaki APK: $cname (build $ccode, commit $(sha_or "$csha" bilinmiyor))"; else say "   Yayında APK yok."; fi
  if [ "$ecode" -le 0 ]; then say "❌ main'deki mobil uygulama sürümü (ApplicationVersion) okunamadı."; trailer BLOCKED 1; return 0; fi
  if [ "$ccode" -ge "$ecode" ]; then
    say "✅ Yayındaki APK main ile güncel; yayınlanacak yeni APK yok. (Yeni APK için csproj'da ApplicationVersion artırılmalı.)"
    trailer NOTHING 1; return 0
  fi
  if ! find_apk_run "$main"; then say "⚠️ GitHub Actions şu an okunamadı (geçici olabilir); biraz sonra tekrar deneyin."; trailer BLOCKED 1; return 0; fi
  if [ -n "$APK_URL" ]; then
    say "📦 İmzalı APK GitHub Actions'ta hazır (çalışma $APK_RUN)."
    say "Yayın: indirme → imza sertifikası, paket adı ($APK_PACKAGE) ve sürüm doğrulaması → $PUBLIC_URL/indir"
    trailer TARGET "$main"
  elif [ "$APK_WAITING" = 1 ]; then
    say "⏳ Bu sürümün imzalı APK derlemesi GitHub'da sürüyor; bitince /apk ile tekrar bakın."; trailer WAITING 1
  else
    say "❌ Bu sürüm için imzalı APK bulunamadı (main'deki CI başarısız olmuş veya artefaktın süresi dolmuş olabilir)."; trailer BLOCKED 1
  fi
}

act_apk() {
  local want=$1 main tmp apk info ipkg iname icode icert mpkg mname mcode ecode ename ccode cname csha cert size
  [[ "$want" =~ ^[0-9a-f]{40}$ ]] || die "Geçersiz commit kimliği." 2
  lock; fetch; load_token
  main=$(rev refs/remotes/origin/main)
  [ -n "$(rev "$want")" ] && git_r merge-base --is-ancestor "$want" "$main" \
    || die "Commit ($(short "$want")) main'de değil; /apk ile yeniden bakın." 6
  read -r ecode ename <<<"$(mobile_expected "$want")"
  read -r ccode cname csha <<<"$(apk_published)"
  if [ "$ecode" -gt 0 ] && [ "$ccode" -ge "$ecode" ]; then
    say "✅ Yayındaki APK zaten $cname (build $ccode); yeni APK yok."; trailer APK_STATE published; return 0
  fi
  find_apk_run "$want" || die "GitHub Actions okunamadı (geçici olabilir)." 4
  if [ -z "$APK_URL" ]; then
    [ "$APK_WAITING" = 1 ] && { say "⏳ İmzalı APK derlemesi GitHub'da sürüyor."; trailer APK_STATE waiting; return 7; }
    die "Bu commit için imzalı APK artefaktı bulunamadı." 7
  fi

  tmp=$BASE/apk-work
  rm -rf "$tmp"; install -d -m 0700 "$tmp" "$tmp/x"
  if [ -n "$SANDBOX" ]; then cp "${APK_URL#file://}" "$tmp/a.zip"
  else gh_curl --max-time 300 -o "$tmp/a.zip" "$APK_URL" 2>/dev/null || die "APK GitHub'dan indirilemedi (geçici olabilir)." 4
  fi
  unzip -q -o "$tmp/a.zip" -d "$tmp/x" 2>/dev/null || die "APK arşivi açılamadı (eksik indirme olabilir)." 4
  apk=$tmp/x/$APK_NAME; info=$tmp/x/apk-info.json
  [ -f "$apk" ] && [ -f "$info" ] || die "Arşivde $APK_NAME veya apk-info.json yok." 1
  unzip -tqq "$apk" >/dev/null 2>&1 || die "APK zip bütünlük denetiminden geçmedi." 1
  IFS=$'\t' read -r ipkg iname icode icert <<<"$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["package"], d["versionName"], int(d["versionCode"]), d["certSha256"].lower(), sep="\t")' "$info")"
  IFS=$'\t' read -r mpkg mname mcode <<<"$(apk_manifest "$apk")" || true
  [ "$mpkg" = "$APK_PACKAGE" ] || die "APK paket adı '$mpkg' (beklenen $APK_PACKAGE); yayınlanmadı." 1
  [ "$mcode" = "$icode" ] && [ "$mname" = "$iname" ] && [ "$ipkg" = "$mpkg" ] || die "APK içindeki sürüm ($mname/$mcode) CI bilgisiyle ($iname/$icode) uyuşmuyor." 1
  [ "$mcode" = "$ecode" ] || die "APK sürümü (build $mcode) commit'teki csproj ile (build $ecode) uyuşmuyor." 1
  if [ -n "$SANDBOX" ]; then cert=$icert
  else
    cert=$(apksigner verify --print-certs "$apk" 2>/dev/null | grep -m1 'certificate SHA-256 digest' | awk '{print $NF}') \
      || die "APK imzası doğrulanamadı (apksigner)." 1
  fi
  [ "$cert" = "$APK_CERT_SHA256" ] || die "APK imza sertifikası beklenen anahtarınki değil; yayınlanmadı." 1
  [ "$mcode" -gt "$ccode" ] || die "APK build numarası ($mcode) yayındakinden ($ccode) büyük değil; telefonlar güncellemeyi almaz." 1

  install -d -m 0700 "$DATA_DIR"
  [ -f "$DATA_DIR/$APK_NAME" ] && cp -p "$DATA_DIR/$APK_NAME" "$DATA_DIR/$APK_NAME.bak-$STAMP"
  [ -f "$DATA_DIR/$APK_NAME.meta.json" ] && cp -p "$DATA_DIR/$APK_NAME.meta.json" "$DATA_DIR/$APK_NAME.meta.json.bak-$STAMP"
  printf '{"versionName":"%s","versionCode":%d,"package":"%s","sha":"%s","run":"%s"}\n' "$mname" "$mcode" "$mpkg" "$want" "$APK_RUN" > "$tmp/meta"
  local owner=(); [ -n "$SANDBOX" ] || owner=(-o "$API_USER" -g "$API_USER")
  install -m 0600 "${owner[@]}" "$apk" "$DATA_DIR/$APK_NAME.upload"
  install -m 0600 "${owner[@]}" "$tmp/meta" "$DATA_DIR/$APK_NAME.meta.json.upload"
  # The APK first, then the meta that announces it: phones never see a version without its file.
  mv -f "$DATA_DIR/$APK_NAME.upload" "$DATA_DIR/$APK_NAME"
  mv -f "$DATA_DIR/$APK_NAME.meta.json.upload" "$DATA_DIR/$APK_NAME.meta.json"
  { ls -t "$DATA_DIR/$APK_NAME".bak-2* 2>/dev/null || true; } | tail -n +4 | xargs -r rm -f
  { ls -t "$DATA_DIR/$APK_NAME".meta.json.bak-2* 2>/dev/null || true; } | tail -n +4 | xargs -r rm -f
  install -d -m 0700 "$STATE"
  printf '%s apk %s %s\n' "$STAMP" "$want" "$mcode" >> "$STATE/history"
  size=$(stat -c %s "$DATA_DIR/$APK_NAME")
  rm -rf "$tmp"

  if [ -z "$SANDBOX" ]; then
    local json; json=$(curl -fsS --max-time 10 "http://127.0.0.1:$PORT/tuptakip/api/guncelleme" 2>/dev/null || true)
    if py_json "$json" 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if d.get("apkReady") and int(d.get("publishedMobileBuild") or 0)==int(sys.argv[1]) else 1)' "$mcode" 2>/dev/null; then
      say "✅ /tuptakip/api/guncelleme yeni sürümü bildiriyor."
    else
      say "⚠️ APK yerinde ama /tuptakip/api/guncelleme henüz yeni sürümü bildirmiyor; /durum ile bakın."
    fi
  fi
  say "📱 ArsanTüpTakip APK yayında: $mname (build $mcode, $((size / 1024 / 1024)) MB, commit $(short "$want"))."
  say "İndirme: $PUBLIC_URL/indir — uygulamalar açılışta güncellemeyi önerir."
  trailer APK_STATE published
  trailer APK_VERSION "$mname"
  trailer APK_BUILD "$mcode"
}

act_apkinfo() {
  [ -f "$1" ] || die "Dosya yok: $1" 2
  apk_manifest "$1"
}

case "$ACTION" in
  status) act_status ;;
  sync) act_sync ;;
  pending) act_pending ;;
  publish) act_publish "$ARG" ;;
  previous) act_previous ;;
  rollback) act_rollback ;;
  apkcheck) act_apkcheck ;;
  apk) act_apk "$ARG" ;;
  apkinfo) act_apkinfo "$ARG" ;;
  *) die "Kullanım: arsantuptakip-release status|sync|pending|publish <sha>|previous|rollback|apkcheck|apk <sha>|apkinfo <dosya>" 2 ;;
esac
