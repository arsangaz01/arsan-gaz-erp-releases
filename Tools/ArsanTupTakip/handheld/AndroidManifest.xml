<?xml version="1.0" encoding="utf-8"?>
<!-- Driver screens for old handhelds (Honeywell EDA50, Android 4.4) that cannot run the MAUI app (minSdk 21). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.arsantuptakip.elterminali"
    android:versionCode="3"
    android:versionName="1.0.2">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 4.4 installs updates only from public storage. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Lets the scan screens claim the Honeywell scanner (data intent API); ignored on other devices. -->
    <uses-permission android:name="com.honeywell.decode.permission.DECODE" />

    <application
        android:label="TüpTakip El Terminali"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Holo.Light.DarkActionBar">
        <activity android:name=".LoginActivity" android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".HomeActivity" />
        <activity android:name=".TripActivity" android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".InfoActivity" android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".StockActivity" android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".PlanActivity" />
    </application>
</manifest>
