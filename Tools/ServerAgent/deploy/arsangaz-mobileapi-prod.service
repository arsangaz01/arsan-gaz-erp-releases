# ÜRETİM: ArsanGazERP MobileApi (arsantuptakip.com: /panel, /api, /indir). Yalnızca 127.0.0.1:5077 dinler;
# dışarıya cloudflared.service (adlandırılmış tünel) açar. Veri: /var/lib/arsangaz-data/prod, veritabanı: PostgreSQL.
[Unit]
Description=ArsanGazERP MobileApi (uretim)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
Conflicts=arsangaz-mobileapi.service

[Service]
Type=simple
User=arsangaz
Group=arsangaz
WorkingDirectory=/opt/arsangaz/mobileapi
EnvironmentFile=/etc/arsangaz/postgres.env
Environment=ARSANGAZ_ENV=prod
Environment=ARSANGAZ_DATA_DIR=/var/lib/arsangaz-data/prod
Environment=ARSANGAZ_DB_PROVIDER=postgres
Environment=ARSANGAZ_OWNER_SID=S-1-5-21-236224559-700927456-377575018-1001
Environment=HOME=/var/lib/arsangaz-data/prod
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_NOLOGO=1
ExecStart=/usr/bin/dotnet /opt/arsangaz/mobileapi/ArsanGazERP.MobileApi.dll
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/arsangaz-data/prod
UMask=0077

[Install]
WantedBy=multi-user.target
