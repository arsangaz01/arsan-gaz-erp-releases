# Bekleyen yayın isteklerini işler (root). Eylemler beyaz listededir; ayrıntı /usr/local/sbin/arsangaz-release.
[Unit]
Description=ArsanGazERP yayin istegi isleyici
After=network-online.target postgresql.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/arsangaz-release --spool
TimeoutStartSec=2h
Nice=5
