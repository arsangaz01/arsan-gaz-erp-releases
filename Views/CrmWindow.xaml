<Window x:Class="ArsanGazERP.Views.CrmWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CRM Firma Kartı" Width="1380" Height="820" MinWidth="1080" MinHeight="680" WindowStartupLocation="CenterOwner">
 <Grid Margin="26,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="CRM VE SATIŞ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Firma listesi ve firma kartı" FontSize="26" FontWeight="Bold" Margin="0,3,0,2"/><TextBlock Text="Aday firmaları takip edin, not ve aktivite kaydedin" Foreground="{StaticResource MutedBrush}"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Adaylardan içe aktar" Click="ImportProspects_Click"/><Button Content="Yenile" Click="Refresh_Click" Style="{StaticResource SecondaryButton}" Margin="0"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,18,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.85*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,12,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Firma, şehir veya sektör ara"/><ComboBox x:Name="StatusFilter" Grid.Column="1" Margin="8,4,0,0" SelectionChanged="StatusFilter_SelectionChanged"><ComboBoxItem Content="Tümü" IsSelected="True"/><ComboBoxItem Content="Yeni"/><ComboBoxItem Content="Aranacak"/><ComboBoxItem Content="Arandı"/><ComboBoxItem Content="Teklif Verildi"/><ComboBoxItem Content="Beklemede"/><ComboBoxItem Content="Müşteri Oldu"/><ComboBoxItem Content="Kaybedildi"/></ComboBox></Grid>
     <DataGrid x:Name="CompaniesGrid" Grid.Row="1" Margin="0,12,0,0" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="CompaniesGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="PUAN" Binding="{Binding Score}" Width="60"/><DataGridTextColumn Header="FİRMA" Binding="{Binding CompanyName}" Width="*"/><DataGridTextColumn Header="İL" Binding="{Binding City}" Width="90"/><DataGridTextColumn Header="DURUM" Binding="{Binding Status}" Width="110"/></DataGrid.Columns></DataGrid>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="FİRMA KARTI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CompanyTitle" Text="Firma seçin" FontSize="22" FontWeight="Bold" Margin="0,5,0,14"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="TELEFON" FontWeight="Bold" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="E-POSTA" FontWeight="Bold" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="PhoneBox" Grid.Row="1"/><TextBox x:Name="EmailBox" Grid.Row="1" Grid.Column="1" Margin="8,4,0,0"/>
      <TextBlock Grid.Row="2" Text="WEB SİTESİ" FontWeight="Bold" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="DURUM" FontWeight="Bold" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="8,12,0,0"/>
      <TextBox x:Name="WebsiteBox" Grid.Row="3"/><ComboBox x:Name="CompanyStatus" Grid.Row="3" Grid.Column="1" Margin="8,4,0,0"><ComboBoxItem Content="Yeni"/><ComboBoxItem Content="Aranacak"/><ComboBoxItem Content="Arandı"/><ComboBoxItem Content="Teklif Verildi"/><ComboBoxItem Content="Beklemede"/><ComboBoxItem Content="Müşteri Oldu"/><ComboBoxItem Content="Kaybedildi"/></ComboBox>
     </Grid>
     <TextBlock Text="ADRES" FontWeight="Bold" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/><TextBox x:Name="AddressBox" AcceptsReturn="True" Height="64" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal" Margin="0,12,0,4"><Button Content="Kartı kaydet" Click="SaveCompany_Click"/><Button Content="Telefon" Click="Phone_Click" Style="{StaticResource SecondaryButton}"/><Button Content="WhatsApp" Click="WhatsApp_Click" Style="{StaticResource SecondaryButton}"/><Button Content="Web sitesi" Click="Website_Click" Style="{StaticResource SecondaryButton}" Margin="0"/></StackPanel>
     <Separator Margin="0,12"/>
     <TextBlock Text="NOT EKLE" FontWeight="Bold" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="NoteBox" AcceptsReturn="True" Height="72" TextWrapping="Wrap"/><Button Content="Notu kaydet" Click="AddNote_Click" HorizontalAlignment="Left" Margin="0,8,0,12"/>
     <DataGrid x:Name="NotesGrid" Height="135" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="TARİH" Binding="{Binding CreatedAtLocal}" Width="130"/><DataGridTextColumn Header="NOT" Binding="{Binding NoteText}" Width="*"/></DataGrid.Columns></DataGrid>
     <TextBlock Text="AKTİVİTELER" FontWeight="Bold" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,4"/><DataGrid x:Name="ActivitiesGrid" Height="135" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="TARİH" Binding="{Binding ActivityAtLocal}" Width="130"/><DataGridTextColumn Header="TÜR" Binding="{Binding ActivityType}" Width="120"/><DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Description}" Width="*"/></DataGrid.Columns></DataGrid>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,10,0,0" Foreground="{StaticResource MutedBrush}"/>
 </Grid>
</Window>
