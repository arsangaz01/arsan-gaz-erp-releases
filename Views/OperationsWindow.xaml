<Window x:Class="ArsanGazERP.Views.OperationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Arsan Gaz ERP V5 Operasyon Merkezi" Width="1250" Height="760" WindowStartupLocation="CenterOwner"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="ARSAN GAZ ERP V5 | CRM + ÜRÜN + TÜP + TAHSİLAT" FontSize="22" FontWeight="Bold" Foreground="#0F4C5C"/><TabControl Grid.Row="1" Margin="0,12"><TabItem Header="CRM"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><TextBox x:Name="CustomerCode" Width="100" Margin="2" ToolTip="Kod"/><TextBox x:Name="CustomerName" Width="220" Margin="2" ToolTip="Firma"/><TextBox x:Name="CustomerPhone" Width="130" Margin="2" ToolTip="Telefon"/><TextBox x:Name="CustomerEmail" Width="190" Margin="2" ToolTip="E-posta"/><TextBox x:Name="CustomerCity" Width="100" Margin="2" ToolTip="İl"/><Button Content="Müşteri Ekle" Click="AddCustomer_Click" Padding="12,6" Margin="4"/><Button Content="Seçileni Sil" Click="DeleteCustomer_Click" Padding="12,6" Margin="4"/></WrapPanel><DataGrid x:Name="Customers" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="True"/></Grid></TabItem><TabItem Header="Ürünler"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><TextBox x:Name="ProductCode" Width="110" Margin="2"/><TextBox x:Name="ProductName" Width="220" Margin="2"/><TextBox x:Name="ProductPrice" Width="110" Margin="2"/><ComboBox x:Name="ProductCurrency" Width="90" Margin="2"><ComboBoxItem Content="TRY" IsSelected="True"/><ComboBoxItem Content="USD"/><ComboBoxItem Content="EUR"/><ComboBoxItem Content="GBP"/></ComboBox><Button Content="Ürün Ekle" Click="AddProduct_Click" Padding="12,6" Margin="4"/><Button Content="Seçileni Sil" Click="DeleteProduct_Click" Padding="12,6" Margin="4"/></WrapPanel><DataGrid x:Name="Products" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="True"/></Grid></TabItem><TabItem Header="Tüp ve Barkod"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><TextBox x:Name="CylinderSerial" Width="130" Margin="2"/><TextBox x:Name="CylinderBarcode" Width="140" Margin="2"/><TextBox x:Name="CylinderGas" Width="130" Margin="2"/><TextBox x:Name="CylinderCapacity" Width="90" Margin="2"/><Button Content="Tüp Ekle" Click="AddCylinder_Click" Padding="12,6" Margin="4"/><Button Content="Depoya Al" Click="MoveWarehouse_Click" Padding="12,6" Margin="4"/></WrapPanel><DataGrid x:Name="Cylinders" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="True"/></Grid></TabItem><TabItem Header="Geciken Tahsilatlar"><DataGrid x:Name="OverdueInvoices" IsReadOnly="True" AutoGenerateColumns="True"/></TabItem></TabControl><TextBlock x:Name="Status" Grid.Row="2" FontWeight="SemiBold" Margin="4"/></Grid></Window>