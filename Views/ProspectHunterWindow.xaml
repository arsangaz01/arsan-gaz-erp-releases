<Window x:Class="ArsanGazERP.Views.ProspectHunterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Müşteri Avcısı" Width="1280" Height="760" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterOwner"><Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="SATIŞ İSTİHBARATI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Müşteri Avcısı" FontSize="26" FontWeight="Bold" Margin="0,3,0,2"/><TextBlock Text="Kamuya açık kurumsal işletme verilerini şehir ve sektör bazında araştırır" Foreground="{StaticResource MutedBrush}"/></StackPanel><Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,16,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ARAMA KAPSAMI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Adana, Mersin, Hatay, Osmaniye, Gaziantep ve Şanlıurfa · 10 hedef sektör" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Şimdi tara" Click="Scan_Click"/><Button Content="Yenile" Click="Refresh_Click" Style="{StaticResource SecondaryButton}" Margin="0"/></StackPanel></Grid></Border><DataGrid x:Name="ProspectsGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"><DataGrid.Columns><DataGridTextColumn Header="PUAN" Binding="{Binding OpportunityScore}" Width="62"/><DataGridTextColumn Header="FİRMA" Binding="{Binding CompanyName}" Width="2*"/><DataGridTextColumn Header="İL" Binding="{Binding City}" Width="90"/><DataGridTextColumn Header="SEKTÖR" Binding="{Binding SectorQuery}" Width="1.4*"/><DataGridTextColumn Header="TELEFON" Binding="{Binding Phone}" Width="125"/><DataGridTextColumn Header="WEB" Binding="{Binding Website}" Width="1.5*"/><DataGridTextColumn Header="ÖNERİLEN ÜRÜNLER" Binding="{Binding RecommendedProducts}" Width="1.6*"/><DataGridTextColumn Header="DURUM" Binding="{Binding Status}" Width="85"/></DataGrid.Columns></DataGrid><TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,10,0,0" Foreground="{StaticResource MutedBrush}"/></Grid></Window>
